# Google PageSpeed Insights API key (server-only). Used by POST /api/scan and POST /api/audit.
VITALS_PAGESPEED_API_KEY=your_pagespeed_api_key_here

# Google Gemini API key (server-only). Used by POST /api/chat and the scan summary in the pipeline.
VITALS_GEMINI_API_KEY=your_gemini_api_key_here

# Supabase project URL. Required by the browser client and the server client.
NEXT_PUBLIC_VITALS_SUPABASE_URL=https://your-project.supabase.co

# Optional alias for NEXT_PUBLIC_VITALS_SUPABASE_URL used by the server client fallback.
VITALS_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon key. Browser client reads NEXT_PUBLIC_ first, then this alias.
NEXT_PUBLIC_VITALS_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Alias for the anon key when NEXT_PUBLIC_VITALS_SUPABASE_ANON_KEY is unset.
VITALS_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (server-only). Required for scan writes that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Optional. Set to true only in local failure-injection tests. Never enable in production.
ENABLE_SABOTAGE=false
